import javax.swing.*;
import java.awt.*;
import java.util.Random;

public class StackVisualizerGUI extends JFrame {
     // Correctly separate components by initializing our backend class
     private final ArrayBoundedStack stackBackend;

     // Simple GUI text slot array representing the physical stack container
     private final JLabel[] visualSlots = new JLabel[10];
     private final JTextField inputField;
     private final JLabel statusLabel;

     public StackVisualizerGUI() {
          // 10 element limit
          this.stackBackend = new ArrayBoundedStack(10);

          // panel config
          setTitle("Simple Stack Visualizer");
          setSize(400, 550);
          setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
          setLocationRelativeTo(null);
          setLayout(new BorderLayout(10, 10));

          // buttons Panel & Input
          JPanel northPanel = new JPanel(new BorderLayout(5, 5));

          JPanel inputRow = new JPanel(new FlowLayout());
          inputField = new JTextField(5);
          inputRow.add(new JLabel("Enter Integer: "));
          inputRow.add(inputField);

          JPanel buttonGrid = new JPanel(new GridLayout(3, 2, 5, 5));
          JButton pushBtn = new JButton("Push");
          JButton popBtn = new JButton("Pop");
          JButton peekBtn = new JButton("Peek");
          JButton clearBtn = new JButton("Clear");
          JButton checkBtn = new JButton("Check Stack");
          JButton randomBtn = new JButton("Random");

          buttonGrid.add(pushBtn);
          buttonGrid.add(popBtn);
          buttonGrid.add(peekBtn);
          buttonGrid.add(clearBtn);
          buttonGrid.add(checkBtn);
          buttonGrid.add(randomBtn);

          northPanel.add(inputRow, BorderLayout.NORTH);
          northPanel.add(buttonGrid, BorderLayout.CENTER);
          add(northPanel, BorderLayout.NORTH);

          // center
          // vertical grid
          JPanel displayGrid = new JPanel(new GridLayout(10, 1, 5, 5));
          displayGrid.setBorder(BorderFactory.createEmptyBorder(10, 40, 10, 40));

          // loop backwards so new items stack up vertically instead of down
          for (int i = 9; i >= 0; i--) {
               visualSlots[i] = new JLabel("[ Empty Slot ]", SwingConstants.CENTER);
               visualSlots[i].setOpaque(true);
               visualSlots[i].setBackground(Color.GRAY);
               visualSlots[i].setBorder(BorderFactory.createLineBorder(Color.BLACK));
               displayGrid.add(visualSlots[i]);
          }
          add(displayGrid, BorderLayout.CENTER);

          // north (buttons)
          statusLabel = new JLabel("Status: Idle");
          JPanel southPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
          southPanel.add(statusLabel);
          add(southPanel, BorderLayout.SOUTH);

          // connects actions to their buttons
          pushBtn.addActionListener(e -> handlePush());
          popBtn.addActionListener(e -> handlePop());
          peekBtn.addActionListener(e -> handlePeek());
          clearBtn.addActionListener(e -> handleClear());
          checkBtn.addActionListener(e -> handleCheck());
          randomBtn.addActionListener(e -> handleRandom());
     }

     // visual updater
     private void refreshVisualDisplay() {
          int[] activeItems = stackBackend.getRawElements();

          // loop through all 10 visual blocks on the screen
          for (int i = 0; i < 10; i++) {
               if (i < activeItems.length) {
                    // If data exists at this index, show the item value
                    visualSlots[i].setText("[" + activeItems[i] + "]");
                    visualSlots[i].setBackground(Color.CYAN); // Default element color
               } else {
                    // Revert to empty block placeholders
                    visualSlots[i].setText("[ Empty Slot ]");
                    visualSlots[i].setBackground(Color.GRAY);
               }
          }

          // highlight the topmost element cleanly if stack has items
          if (!stackBackend.isEmpty()) {
               int top = stackBackend.size() - 1;
               visualSlots[top].setText("TOP ➔ [" + activeItems[top] + "]");
               visualSlots[top].setBackground(Color.BLUE); // Highlights true top item
          }
     }

     // operations

     // pushes a new element to the top of the stack
     private void handlePush() {
          try {
               int val = Integer.parseInt(inputField.getText().trim());
               stackBackend.push(val);
               statusLabel.setText("SUCCESS: Pushed value " + val);
               inputField.setText("");
               refreshVisualDisplay();
          } catch (NumberFormatException ex) {
               statusLabel.setText("ERROR: Please enter a valid integer.");
          } catch (StackOverflowError ex) {
               statusLabel.setText("STACK OVERFLOW: Cannot push, stack is full");
          }
     }

     // removes and returns the newest item from the top of the stack
     private void handlePop() {
          if (stackBackend.isEmpty()) {
               statusLabel.setText("STACK UNDERFLOW: Cannot pop, stack is empty");
          } else {
               int poppedVal = stackBackend.pop();
               statusLabel.setText("SUCCESS: Popped top element value (" + poppedVal + ")");
               refreshVisualDisplay();
          }
     }

     // looks at the top element without deleting it
     private void handlePeek() {
          if (stackBackend.isEmpty()) {
               statusLabel.setText("EMPTY-STACK STATUS MESSAGE: Cannot Peek from empty stack.");
          } else {
               int topVal = stackBackend.peek();
               statusLabel.setText("PEEK: The element currently at the TOP is: " + topVal);

               // to show the peek check
               int topPos = stackBackend.size() - 1;
               visualSlots[topPos].setBackground(Color.MAGENTA);
          }
     }

     // Resets the stack pointer (forcing it back down to -1) and clears all items instantly
     private void handleClear() {
          stackBackend.clear();
          statusLabel.setText("SUCCESS: Stack completely cleared and emptied.");
          refreshVisualDisplay();
     }

     // checks if the stack is currently empty, full, or has space
     private void handleCheck() {
          if (stackBackend.isEmpty()) {
               statusLabel.setText("CHECK STACK: Stack is currently EMPTY.");
          } else if (stackBackend.isFull()) {
               statusLabel.setText("CHECK STACK: Stack is currently FULL (10/10 items).");
          } else {
               statusLabel.setText("CHECK STACK: Stack contains " + stackBackend.size() + " items.");
          }
     }

     // clears the stacks and inputs it with random numbers of item (1 to 100)
     private void handleRandom() {
          stackBackend.clear();
          Random rand = new Random();
          int count = rand.nextInt(10) + 1; // 1 to 10 items

          for (int i = 0; i < count; i++) {
               stackBackend.push(rand.nextInt(100) + 1); // Random item values 1-100
          }
          statusLabel.setText("RANDOMIZED: Built a stack with " + count + " elements.");
          refreshVisualDisplay();
     }

     public static void main(String[] args) {
          SwingUtilities.invokeLater(() -> {
               new StackVisualizerGUI().setVisible(true);
          });
     }
}
